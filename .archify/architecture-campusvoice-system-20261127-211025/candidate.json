  "cards": [
    {
      "dot": "cyan",
      "title": "Role-Isolated Portals",
      "items": [
        "Gateway (/), Student (/student), Department (/department), and Admin (/admin) served from FastAPI",
        "Supports English, Hindi, and Bengali UI (425 keys in i18n.js) plus Web Speech STT and TTS",
        "Dynamic PNG QR Standee (/api/qr/code) detects LAN IP for mobile onboarding over 0.0.0.0:8000"
      ]
    },
    {
      "dot": "emerald",
      "title": "Real-Time Event & AI Pipeline",
      "items": [
        "RealtimeHub pushes scoped WebSocket events from sync API routes via run_coroutine_threadsafe",
        "HybridNLPService uses optional Gemini 2.5 Flash or local multilingual rules for 0-100 urgency scoring",
        "NoticeService generates downloadable PDF 1.4 circulars and broadcasts alerts to all students"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Persistence",
      "items": [
        "Passwords salted and hashed via PBKDF2-HMAC-SHA256 (100,000 iterations) in auth_service.py",
        "HttpOnly SameSite=Lax HMAC-SHA256 cv_session cookie isolates student complaints and locks dept queues",
        "SQLite runs in WAL mode with 5000ms busy timeout storing Users, Complaints, Notices, and Notifications"
      ]
    }
  ]
